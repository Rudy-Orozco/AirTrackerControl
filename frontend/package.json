{
  "name": "frontend",
  "productName": "Air Traffic Art",
  "description": "Live air traffic around an airport: map, 3D views and a split-flap arrivals/departures board.",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "node -e \"for (const p of ['dist', 'release', 'node_modules/.tmp', 'node_modules/.vite']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && node electron/start.mjs",
    "desktop:kiosk": "npm run build && node electron/start.mjs --kiosk",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.airtrafficart.app",
    "productName": "Air Traffic Art",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "electron/preload.cjs",
      "api-routes.mjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
